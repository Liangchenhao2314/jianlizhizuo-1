# 智简简历服务端配置示例：复制为 .env 并按需填写
# 服务器端口（Railway 会自动注入 PORT）
PORT=3000

# 服务端 AI 密钥（启用「服务端代理」模式时使用，密钥不会下发到浏览器）
# 豆包（火山方舟）
DOUBAO_API_KEY=
DOUBAO_MODEL=doubao-1-5-pro-32k-250115

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 千问（通义千问 DashScope 兼容模式）
QWEN_API_KEY=
QWEN_MODEL=qwen-plus

# OpenAI 兼容接口（自定义服务也可填）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
